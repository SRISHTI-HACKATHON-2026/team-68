{
  "projectName": "ComprehensionAI - Comprehension-First Learning System",
  "version": "1.0.0",
  "hackathon": "SDM Hackathon",
  "date": "2026-04-28",
  "description": "AI-powered learning system that detects real understanding gaps in students rather than just marking answers as right or wrong.",
  "features": {
    "misconceptionDetection": {
      "types": [
        "Conceptual Error",
        "Partial Understanding",
        "Rote Memorization",
        "Irrelevant Guessing",
        "Correct Understanding"
      ],
      "algorithm": "Keyword-matching rule-based approach",
      "languages": ["English", "Kannada", "Hindi"],
      "offline": true
    },
    "adaptiveFeedback": {
      "plainLanguageExplanation": true,
      "storyBasedLearning": true,
      "visualRepresentations": true,
      "peerDiscussionPrompts": true,
      "ageAppropriate": true
    },
    "teacherTools": {
      "misconceptionDashboard": true,
      "classWideTrends": true,
      "commonErrorIdentification": true,
      "exportReports": true,
      "recommendations": true
    }
  },
  "technology": {
    "frontend": {
      "framework": "React 18.2",
      "routing": "React Router v6",
      "http": "Axios",
      "styling": "CSS3",
      "icons": "React Icons",
      "responsiveness": "CSS Grid & Flexbox"
    },
    "backend": {
      "runtime": "Node.js",
      "framework": "Express.js 4.18",
      "middleware": ["CORS", "Body Parser"],
      "architecture": "RESTful API"
    },
    "data": {
      "format": "JSON",
      "storage": "Local filesystem (offline-capable)",
      "persistence": "IndexedDB ready"
    }
  },
  "projectStructure": {
    "frontend": {
      "components": [
        "Navigation.js",
        "QuestionCard.js",
        "FeedbackPanel.js"
      ],
      "pages": [
        "StudentInterface.js",
        "TeacherDashboard.js"
      ],
      "styles": [
        "App.css",
        "Navigation.css",
        "StudentInterface.css",
        "QuestionCard.css",
        "FeedbackPanel.css",
        "TeacherDashboard.css"
      ]
    },
    "backend": {
      "files": [
        "server.js",
        "MisconceptionDetector (in server.js)"
      ]
    },
    "data": {
      "questions": [
        "science-questions.json - 5 sample questions"
      ],
      "concepts": [
        "science-concepts.json - 5 concepts with metadata"
      ],
      "languages": [
        "translations.json - 3 languages"
      ]
    }
  },
  "features_implemented": {
    "studentInterface": [
      "Question display with context and hints",
      "Answer input with character counting",
      "Real-time validation",
      "Progress tracking",
      "Navigation between questions"
    ],
    "feedbackSystem": [
      "Misconception type classification",
      "Confidence and score display",
      "Expandable feedback sections",
      "Keyword highlighting",
      "Story-based explanations",
      "Visual representation suggestions",
      "Peer discussion prompts"
    ],
    "teacherDashboard": [
      "Statistics grid with 4 key metrics",
      "Concept-wise misconception breakdown",
      "Common error identification",
      "Visual progress bars",
      "Concept filtering",
      "Report export functionality",
      "Educational recommendations"
    ],
    "userInterface": [
      "Beautiful gradient design",
      "Smooth animations",
      "Responsive layout",
      "Dark color scheme",
      "Accessibility features",
      "Mobile-friendly"
    ],
    "multiLanguageSupport": [
      "English",
      "Kannada (ಕನ್ನಡ)",
      "Hindi (हिंदी)",
      "Language switcher in navigation"
    ],
    "offlineCapability": [
      "All data in local JSON files",
      "No API calls required after setup",
      "Local storage ready for student responses",
      "Works in low-resource environments"
    ]
  },
  "APIEndpoints": {
    "getQuestions": {
      "method": "GET",
      "path": "/api/questions",
      "description": "Get all questions"
    },
    "getQuestion": {
      "method": "GET",
      "path": "/api/questions/:id",
      "description": "Get specific question"
    },
    "analyzeAnswer": {
      "method": "POST",
      "path": "/api/analyze",
      "description": "Analyze student answer",
      "body": {
        "questionId": "string",
        "studentAnswer": "string",
        "language": "string"
      }
    },
    "getConcepts": {
      "method": "GET",
      "path": "/api/concepts",
      "description": "Get all concepts"
    },
    "getLanguages": {
      "method": "GET",
      "path": "/api/languages",
      "description": "Get all languages"
    },
    "teacherMisconceptionsSummary": {
      "method": "GET",
      "path": "/api/teacher/misconceptions-summary",
      "description": "Get class-wide misconception summary"
    }
  },
  "datasets": {
    "sampleQuestions": 5,
    "sampleConcepts": 5,
    "supportedLanguages": 3,
    "misconceptionTypes": 5
  },
  "performanceMetrics": {
    "pageLoadTime": "< 2s",
    "responseTime": "< 100ms",
    "bundleSize": "< 500KB",
    "numberOfRequests": "Minimal (offline-first)"
  },
  "setupInstructions": {
    "backend": [
      "cd backend",
      "npm install",
      "npm start"
    ],
    "frontend": [
      "cd frontend",
      "npm install",
      "npm start"
    ],
    "urls": {
      "backend": "http://localhost:5000",
      "frontend": "http://localhost:3000"
    ]
  },
  "fileLocations": {
    "questions": "data/questions/science-questions.json",
    "concepts": "data/concepts/science-concepts.json",
    "languages": "data/languages/translations.json",
    "backendServer": "backend/server.js",
    "frontendApp": "frontend/src/App.js"
  },
  "supportedBrowsers": [
    "Chrome (latest)",
    "Firefox (latest)",
    "Safari (latest)",
    "Edge (latest)",
    "Mobile browsers"
  ],
  "accessories": [
    "README.md - Comprehensive documentation",
    "SETUP.md - Quick setup guide",
    "DEVELOPER_GUIDE.md - Development reference",
    "project.json - This file"
  ],
  "innovationHighlights": [
    "Detects 5 types of misconceptions instead of just pass/fail",
    "Story-based adaptive explanations",
    "Peer discussion prompts for collaborative learning",
    "Multi-language support for inclusive education",
    "Works offline - perfect for low-resource environments",
    "Beautiful, intuitive UI designed for students",
    "Comprehensive teacher dashboard",
    "Rule-based approach suitable for hackathon timeline"
  ],
  "targetUsers": [
    "Students (ages 8-18)",
    "Teachers in low-resource schools",
    "Online learning platforms",
    "Educational content creators"
  ],
  "impact": {
    "studentEngagement": "Personalized adaptive feedback increases motivation",
    "learningEfficiency": "Identifying misconceptions accelerates learning",
    "teacherEfficiency": "Automated analysis saves teacher time",
    "inclusivity": "Offline capability and multi-language support",
    "accessibility": "Works on any browser without additional software"
  }
}
